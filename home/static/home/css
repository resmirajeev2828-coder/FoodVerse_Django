}

body{
    background:#f8f9fa;
}

.navbar-brand{
    font-size:28px;
    font-weight:bold;
}

.card{
    border:none;
    border-radius:15px;
    overflow:hidden;
    box-shadow:0 5px 15px rgba(0,0,0,0.1);
    transition:0.3s;
}

.card img{
    height:220px;
    object-fit:cover;
}

.card:hover{
    transform:translateY(-8px);
}

.btn{
    border-radius:30px;
}

footer{
    margin-top:60px;
}