body{
    font-family: Arial, sans-serif;
}

.hero{
    height:80vh;
    background:url("https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=1600") center/cover;
}

.hero h1{
    font-size:60px;
    font-weight:bold;
}

.hero p{
    font-size:20px;
}

.card{
    transition:0.3s;
}

